@model Cosmechic.Models.OrderHeader
@using Cosmechic.Services
@inject ICancellationService CancellationService

@{
    ViewData["Title"] = "Details de la commande";
    if (User.IsInRole("Admin"))
    {
        Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    }
}
<section class="py-5" style="margin-top: 100px;">
    <div class="text-center">
        <h1 class="fw-bold" style=" color:darkblue">
            @ViewData["Title"]
        </h1>
    </div>
</section>
<hr />


<div class="container text-center rounded bg-white mt-5 mb-5 py-5" style="margin-top: 100px;">
    <div class="row">
        <div class="col-md-8 py-5">
            <dl class="row">
                <dt class="col-sm-4">Numéro de commande</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Id)</dd>

                <dt class="col-sm-4">Nom du client</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Name)</dd>

                <dt class="col-sm-4">Date de la commande:</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.OrderDate)</dd>

                <dt class="col-sm-4">Sous-total:</dt>
                <dd class="col-sm-8">@Model.Subtotal.ToString("0.00") CAD</dd>

                <dt class="col-sm-4">Livraison@(string.IsNullOrEmpty(Model.ShippingMethodName) ? "" : $" ({Model.ShippingMethodName})"):</dt>
                <dd class="col-sm-8">@Model.ShippingAmount.ToString("0.00") CAD</dd>

                <dt class="col-sm-4">Taxes:</dt>
                <dd class="col-sm-8">@Model.TaxAmount.ToString("0.00") CAD</dd>

                @if (Model.DiscountAmount > 0)
                {
                    <dt class="col-sm-4">Rabais:</dt>
                    <dd class="col-sm-8">-@Model.DiscountAmount.ToString("0.00") CAD</dd>
                }

                <dt class="col-sm-4">Total de la commande:</dt>
                <dd class="col-sm-8"><strong>@Model.OrderTotal.ToString("0.00") CAD</strong></dd>

                <dt class="col-sm-4">Statut de la commande</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.OrderStatus)</dd>

                <dt class="col-sm-4">Statut du paiement</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.PaymentStatus)</dd>

                <dt class="col-sm-4">Statut de l'expédition</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.FulfillmentStatus)</dd>

                <dt class="col-sm-4">Numéro de suivi</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.TrackingNumber)</dd>
            </dl>
            <a class="btn btn-secondary" asp-action="Index">Retour</a>
            <a class="btn btn-outline-primary" asp-controller="Cart" asp-action="Receipt" asp-route-id="@Model.Id">Voir le reçu</a>
            @if (Model.FulfillmentStatus is "Shipped" or "Delivered")
            {
                <a class="btn btn-outline-warning" asp-controller="Returns" asp-action="Request" asp-route-orderId="@Model.Id">Demander un retour</a>
            }
            @* COSMECHIC-ACCOUNT-001 (section 20) : éligibilité demandée au backend
               (ICancellationService.CanCancel), jamais réimplémentée dans la vue. *@
            @if (CancellationService.CanCancel(Model) is CancellationEligible)
            {
                <form asp-controller="Cart" asp-action="CancelOrder" method="post" style="display:inline" id="cancelOrderForm">
                    <input type="hidden" name="orderId" value="@Model.Id" />
                    <button type="submit" class="btn btn-outline-danger">Annuler la commande</button>
                </form>
            }
        </div>
    </div>
</div>

@* CSP interdit les attributs onclick inline : confirmation attachée via un script nonce. *@
<script nonce="@CspNonce.Nonce">
    document.getElementById('cancelOrderForm')?.addEventListener('submit', function (e) {
        if (!confirm('Annuler cette commande ?')) {
            e.preventDefault();
        }
    });
</script>

