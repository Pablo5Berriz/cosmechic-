@using Cosmechic.Models.ViewModels
@model CheckoutSummaryVM

@{
	ViewData["Title"] = "Vérification de la commande";
}

<section class="py-5" style="margin-top: 100px;">
	<div class="text-center">
		<h1 class="fw-folder" style="color:darkblue">
			@ViewData["Title"]
		</h1>
	</div>
</section>

@if (!Model.ShippingMethods.Any())
{
	<div class="container">
		<div class="alert alert-warning">
			Aucune méthode de livraison n'est actuellement configurée. Veuillez réessayer plus tard.
		</div>
		<a asp-action="Index" class="btn btn-danger btn-sm">Retour au panier</a>
	</div>
	return;
}

<form method="post" id="checkout-form">
	<br />
	<div class="container">
		<div class="card shadow border-0">
			<div class="card-header bg-secondary bg-gradient text-light ml-0 py-4">
				<div class="row px-4">
					<div class="col-6">
						<h5 class="pt-2 text-white">
							Sommaire de la commande
						</h5>
					</div>
					<div class="col-6 text-end">
						<a asp-action="Index" class="btn btn-danger btn-sm">Retour au panier</a>
					</div>
				</div>
			</div>
			<div class="card-body">
				<div class="container rounded p-2">
					<div class="row">
						<div class="col-12 col-lg-6 pb-4">
							<div class="row">
								<h4 class="d-flex justify-content-between align-items-center mb-3">
									<span class="text-info">Informations de livraison:</span>
								</h4>
							</div>
								@* COSMECHIC-ACCOUNT-001 (section 15) : sélection d'une adresse
								   enregistrée, ou saisie ponctuelle. Le serveur revérifie
								   l'ownership de l'adresse choisie (SummaryPOST) — cette
								   sélection n'est qu'un confort d'affichage. *@
								<input type="hidden" asp-for="Input.SelectedAddressId" id="selectedAddressId" />
								@if (Model.SavedAddresses.Any())
								{
									<fieldset class="mb-3">
										<legend class="h6">Adresse de livraison</legend>
										@foreach (var address in Model.SavedAddresses)
										{
											<div class="form-check saved-address-option"
												 data-id="@address.Id" data-recipient="@address.RecipientName" data-phone="@address.PhoneNumber"
												 data-street="@address.StreetAddress" data-city="@address.City" data-state="@address.State" data-postal="@address.PostalCode">
												<input class="form-check-input saved-address-radio" type="radio" name="savedAddressChoice"
													   id="savedAddress_@address.Id" value="@address.Id" @(Model.Input.SelectedAddressId == address.Id ? "checked" : "") />
												<label class="form-check-label" for="savedAddress_@address.Id">
													<strong>@address.Label</strong> — @address.RecipientName, @address.StreetAddress, @address.City @address.State @address.PostalCode
												</label>
											</div>
										}
										<div class="form-check saved-address-option" data-id="">
											<input class="form-check-input saved-address-radio" type="radio" name="savedAddressChoice"
												   id="savedAddress_new" value="" @(Model.Input.SelectedAddressId == null ? "checked" : "") />
											<label class="form-check-label" for="savedAddress_new">Nouvelle adresse</label>
										</div>
									</fieldset>
								}
							<div class="row my-1">
								<div class="col-3">
									<label>Nom</label>
								</div>
								<div class="col-9">
									<input asp-for="Input.Name" class="form-control"/>
									<span asp-validation-for="Input.Name" class="text-danger"></span>
								</div>
							</div>
							<div class="row my-1">
								<div class="col-3">
									<label>Téléphone</label>
								</div>
								<div class="col-9">
									<input asp-for="Input.PhoneNumber" class="form-control"/>
									<span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
								</div>
							</div>
							<div class="row my-1">
								<div class="col-3">
									<label>Addresse</label>
								</div>
								<div class="col-9">
									<input asp-for="Input.StreetAddress" class="form-control"/>
									<span asp-validation-for="Input.StreetAddress" class="text-danger"></span>
								</div>
							</div>
							<div class="row my-1">
								<div class="col-3">
									<label>Ville</label>
								</div>
								<div class="col-9">
									<input asp-for="Input.City" class="form-control"/>
									<span asp-validation-for="Input.City" class="text-danger"></span>
								</div>
							</div>
							<div class="row my-1">
								<div class="col-3">
									<label>Province</label>
								</div>
								<div class="col-9">
									<input asp-for="Input.State" id="stateInput" class="form-control" placeholder="ex. QC" />
									<span asp-validation-for="Input.State" class="text-danger"></span>
								</div>
							</div>
							<div class="row my-1">
								<div class="col-3">
									<label>Code Postal</label>
								</div>
								<div class="col-9">
									<input asp-for="Input.PostalCode" class="form-control"/>
									<span asp-validation-for="Input.PostalCode" class="text-danger"></span>
								</div>
							</div>

							<div class="row mt-4">
								<h4 class="d-flex justify-content-between align-items-center mb-3">
									<span class="text-info">Méthode de livraison:</span>
								</h4>
							</div>
							@for (var i = 0; i < Model.ShippingMethods.Count; i++)
							{
								var method = Model.ShippingMethods[i];
								<div class="form-check my-1 shipping-method-option"
									 data-price="@method.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)"
									 data-threshold="@(method.FreeShippingThreshold?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")">
									<input class="form-check-input shipping-method-radio" type="radio" name="ShippingMethodId"
										   id="shippingMethod_@method.ShippingMethodId" value="@method.ShippingMethodId" @(i == 0 ? "checked" : "") />
									<label class="form-check-label" for="shippingMethod_@method.ShippingMethodId">
										@method.Name — @method.Price.ToString("0.00") CAD
										@if (method.FreeShippingThreshold.HasValue)
										{
											<small class="text-muted">(gratuit à partir de @method.FreeShippingThreshold.Value.ToString("0.00") CAD)</small>
										}
									</label>
								</div>
							}
						</div>
						<div class="col-12 col-lg-5 offset-lg-1">
							<h4 class="d-flex justify-content-between align-items-center mb-3">
								<span class="text-info">Sommaire de la commande:</span>
							</h4>
							<ul class="list-group mb-3">
								@foreach (var details in Model.ShoppingCartList)
								{
									<li class="list-group-item d-flex justify-content-between align-items-center">
										<div>
											<h6 class="my-0">@details.Produit.Nom</h6>
											<small class="text-muted">Quantité: @details.Count</small>
										</div>
										<span class="text-muted">@(details.Prix * details.Count) CAD</span>
									</li>
								}
								<li class="list-group-item d-flex justify-content-between">
									<span class="text-muted">Sous-total:</span>
									<span class="text-muted" id="subtotalDisplay">@Model.Subtotal.ToString("0.00") CAD</span>
								</li>
								<li class="list-group-item d-flex justify-content-between">
									<span class="text-muted">Livraison:</span>
									<span class="text-muted" id="shippingDisplay">0.00 CAD</span>
								</li>
								<li class="list-group-item d-flex justify-content-between">
									<span class="text-muted">Taxes (aperçu):</span>
									<span class="text-muted" id="taxDisplay">0.00 CAD</span>
								</li>
								<li class="list-group-item d-flex justify-content-between bg-light">
									<small class="text-info">Total (aperçu, CAD)</small>
									<strong class="text-info" id="totalDisplay">0.00 CAD</strong>
								</li>
							</ul>
							<p class="text-muted"><small>Le montant exact facturé est calculé par le serveur et confirmé à l'étape suivante, avant le paiement.</small></p>
						</div>
						<div class="card-footer">
							<div class="row">
								<div class="col-md-8">
									<p class="text-muted">
										Date de livraison approximative: @DateTime.Now.AddDays(7).ToShortDateString() - @DateTime.Now.AddDays(14).ToShortDateString()
									</p>
								</div>
								<div class="col-md-4">
									<button type="submit" value="Place Order" class="btn btn-primary btn-block">Passer au paiement</button>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</form>

@* COSMECHIC-COMMERCE-OPERATIONS-001A (section 44) : aperçu client uniquement — ne
   détermine jamais le montant facturé. Le serveur (OrderCheckoutService) recalcule
   toujours Subtotal/ShippingAmount/TaxAmount/OrderTotal depuis la base, indépendamment
   de ce script. Mirroir volontairement simple de RegionCodeResolver.ResolveCanadianRegionCode
   (Québec uniquement reconnu explicitement) pour rester cohérent avec le calcul serveur. *@
<script nonce="@CspNonce.Nonce">
	(function () {
		var subtotal = @Html.Raw(Model.Subtotal.ToString(System.Globalization.CultureInfo.InvariantCulture));
		var taxRates = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ActiveTaxRates.Select(r => new { r.RegionCode, r.Rate })));

		function resolveRegionCode(state) {
			if (!state) return null;
			var normalized = state.normalize("NFD").replace(/[̀-ͯ]/g, "").trim().toUpperCase();
			if (normalized === "QC" || normalized === "QUEBEC") return "QC";
			return normalized.length === 2 ? normalized : null;
		}

		function recompute() {
			var selected = document.querySelector('.shipping-method-radio:checked');
			var shippingAmount = 0;
			if (selected) {
				var option = selected.closest('.shipping-method-option');
				var price = parseFloat(option.getAttribute('data-price')) || 0;
				var thresholdAttr = option.getAttribute('data-threshold');
				if (thresholdAttr && subtotal >= parseFloat(thresholdAttr)) {
					shippingAmount = 0;
				} else {
					shippingAmount = price;
				}
			}

			var regionCode = resolveRegionCode(document.getElementById('stateInput').value);
			var taxAmount = 0;
			taxRates.forEach(function (rate) {
				if (rate.RegionCode === null || rate.RegionCode === regionCode) {
					taxAmount += Math.round(subtotal * rate.Rate * 100) / 100;
				}
			});

			var total = subtotal + shippingAmount + taxAmount;

			document.getElementById('shippingDisplay').textContent = shippingAmount.toFixed(2) + ' CAD';
			document.getElementById('taxDisplay').textContent = taxAmount.toFixed(2) + ' CAD';
			document.getElementById('totalDisplay').textContent = total.toFixed(2) + ' CAD';
		}

		document.querySelectorAll('.shipping-method-radio').forEach(function (el) {
			el.addEventListener('change', recompute);
		});
		document.getElementById('stateInput').addEventListener('input', recompute);

		// COSMECHIC-ACCOUNT-001 (section 15) : sélectionner une adresse enregistrée
		// préremplit (et verrouille) les champs de saisie ponctuelle et renseigne le
		// champ caché SelectedAddressId ; "Nouvelle adresse" les déverrouille et vide ce
		// champ. Confort d'affichage uniquement — SummaryPOST revérifie tout côté serveur.
		var freeTextFields = {
			name: document.getElementById('Input_Name'),
			phone: document.getElementById('Input_PhoneNumber'),
			street: document.getElementById('Input_StreetAddress'),
			city: document.getElementById('Input_City'),
			state: document.getElementById('stateInput'),
			postal: document.getElementById('Input_PostalCode'),
		};
		var selectedAddressIdField = document.getElementById('selectedAddressId');

		function applySavedAddressChoice(option) {
			var addressId = option.getAttribute('data-id');
			if (addressId) {
				selectedAddressIdField.value = addressId;
				freeTextFields.name.value = option.getAttribute('data-recipient') || '';
				freeTextFields.phone.value = option.getAttribute('data-phone') || '';
				freeTextFields.street.value = option.getAttribute('data-street') || '';
				freeTextFields.city.value = option.getAttribute('data-city') || '';
				freeTextFields.state.value = option.getAttribute('data-state') || '';
				freeTextFields.postal.value = option.getAttribute('data-postal') || '';
				Object.values(freeTextFields).forEach(function (el) { el.readOnly = true; });
			} else {
				selectedAddressIdField.value = '';
				Object.values(freeTextFields).forEach(function (el) { el.readOnly = false; });
			}
			recompute();
		}

		document.querySelectorAll('.saved-address-radio').forEach(function (el) {
			el.addEventListener('change', function () {
				applySavedAddressChoice(el.closest('.saved-address-option'));
			});
		});
		var initiallyChecked = document.querySelector('.saved-address-radio:checked');
		if (initiallyChecked) {
			applySavedAddressChoice(initiallyChecked.closest('.saved-address-option'));
		}

		recompute();
	})();
</script>
