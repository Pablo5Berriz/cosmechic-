@model Cosmechic.ViewModels.HomeIndexViewModel

@{
    ViewData["Title"] = "Accueil";
    ViewData["MetaDescription"] = "Cosmechic, boutique en ligne de produits cosmétiques pour les personnes afro, noires et métissées.";
}

@* COSMECHIC-UX-001 (section 8) : styles spécifiques à la page réduits au strict
   nécessaire (bannière, animation d'entrée) — la mise en page des cartes/grilles
   réutilise désormais les classes Bootstrap + design-system.css (.cx-product-card,
   .cx-card-hover) plutôt qu'une largeur de carte fixe (450px) qui provoquait un
   débordement horizontal sur mobile. *@
<style>
    body {
        background-color: var(--cx-color-bg, ghostwhite);
    }

    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .animate-section {
        margin-bottom: 100px;
        animation: fadeInUp 1s ease-out both;
    }

    @@media (prefers-reduced-motion: reduce) {
        .animate-section {
            animation: none;
        }
    }

    .banner {
        position: relative;
        width: 100%;
        height: 70vh;
        min-height: 320px;
        overflow: hidden;
    }

        .banner img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .banner-overlay {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        text-align: center;
        color: #fff;
        background: rgba(0, 0, 0, 0.5);
        padding: 30px;
        border-radius: 10px;
        max-width: 90%;
    }

    .section-heading {
        margin-top: 50px;
        margin-bottom: 30px;
        text-align: center;
    }
</style>

<!-- Contenu Principal -->
<div>
    <!-- 1. Bannière principale pleine largeur -->
    <section class="animate-section banner">
        <img src="~/Images log_register_forgot/Accueil.jpg" alt="Bienvenue à Cosmechic">
        <div class="banner-overlay">
            <h1>Bienvenue chez Cosmechic</h1>
            <h5>Votre boutique afro par excellence</h5>
            <a class="btn btn-primary" asp-controller="Categories" asp-action="Customer">
                Consulter nos catégories
            </a>
        </div>
    </section>

    <!-- 2. Nos Engagements & Valeurs -->
    <section class="animate-section container text-center">
        <div class="section-heading">
            <h2>Nos Engagements & Valeurs</h2>
        </div>
        <p>Chez Cosmechic, nous nous engageons à offrir des produits naturels et éthiques qui respectent votre peau et vos cheveux.</p>
        <p>Nous favorisons des ingrédients biologiques et soutenons les artisans afro-descendants dans le monde entier.</p>
    </section>

    <!-- 3. Nos Best-Sellers -->
    <section class="animate-section container-fluid">
        <div class="section-heading text-center">
            <h2>Nos Best-Sellers</h2>
        </div>
        @if (!Model.BestSellers.Any())
        {
            <div class="cx-empty-state">
                <i class="bi bi-bag" aria-hidden="true"></i>
                <p class="mb-0">Aucun produit à afficher pour le moment.</p>
            </div>
        }
        else
        {
            <div class="row row-cols-2 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4 justify-content-center">
                @foreach (var produit in Model.BestSellers)
                {
                    <div class="col">
                        <div class="card cx-product-card cx-card-hover h-100">
                            <img src="@Url.Content("~/Images_Produits/" + produit.Image)" class="card-img-top" alt="@produit.Nom">
                            <div class="card-body">
                                <h3 class="card-title h5">@produit.Nom</h3>
                                <p class="card-text">@produit.Prix.ToString("0.00") CAD</p>
                                <a class="btn btn-outline-primary" asp-controller="Produits" asp-action="ItemDetails" asp-route-productId="@produit.ProduitId">
                                    <i class="bi bi-cart-plus" aria-hidden="true"></i> Voir le produit
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </section>

    <!-- 4. Promotions & Offres Spéciales -->
    <section class="animate-section container">
        <div class="section-heading text-center">
            <h2>Promotions & Offres Spéciales</h2>
        </div>
        <div class="row">
            @foreach (var promo in Model.Promotions)
            {
                <div class="col-md-6">
                    <div class="promo-card">
                        <h5>@promo.Titre</h5>
                        <p>@promo.Description</p>
                        <p class="text-danger"><strong>Remise: @promo.Remise%</strong></p>
                    </div>
                </div>
            }
        </div>
    </section>

    @* COSMECHIC-UX-001 : le bouton "Lire l'article" pointait vers href="#" — aucune
       page de détail d'article n'est implémentée dans l'application (pas de route
       Blog/Details). Plutôt que de fabriquer un lien mort ou une fausse promesse,
       l'aperçu de l'extrait est conservé sans CTA cliquable. *@
    @if (Model.ArticlesBlog.Any())
    {
        <section class="animate-section container-fluid">
            <div class="section-heading text-center">
                <h2>Blog & Conseils Beauté</h2>
            </div>
            <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4 justify-content-center">
                @foreach (var article in Model.ArticlesBlog)
                {
                    <div class="col">
                        <div class="card cx-card-hover h-100">
                            <img src="@Url.Content("~/Images_Blog/" + article.Image)" class="card-img-top" alt="@article.Titre">
                            <div class="card-body">
                                <h3 class="card-title h5">@article.Titre</h3>
                                <p class="card-text">@article.Extrait</p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </section>
    }

    <!-- 6. Témoignages Clients -->
    <section class="animate-section container">
        <div class="section-heading text-center">
            <h2>Avis Clients</h2>
        </div>
        <div class="row">
            @foreach (var temoignage in Model.Temoignages)
            {
                <div class="col-md-4">
                    <div class="testimonial">
                        <div class="d-flex align-items-center">
                            <img src="~/Images/avatar.png" alt="Avatar" class="rounded-circle me-2" width="40" height="40">
                            <strong>@temoignage.Nom</strong>
                        </div>
                        <div class="mt-2 text-warning">
                            @for (int i = 0; i < temoignage.Note; i++)
                            {
                                <i class="bi bi-star-fill"></i>
                            }
                            @for (int i = temoignage.Note; i < 5; i++)
                            {
                                <i class="bi bi-star"></i>
                            }
                        </div>
                        <strong class="d-block">@temoignage.ProduitNom</strong>
                        <small class="text-muted">Évalué le @temoignage.Date.ToString("dd MMMM yyyy")</small>
                        <p class="fst-italic">"@temoignage.Commentaire"</p>
                    </div>
                </div>
            }
        </div>
    </section>

    @* COSMECHIC-UX-001 : la section "Newsletter" ne postait nulle part (aucune
       action de formulaire, aucun backend) — fonctionnalité fictive contredisant
       en plus la page Confidentialité ("Cosmechic n'utilise pas vos données à des
       fins marketing"). Supprimée plutôt que maquillée. Le second formulaire de
       contact postait vers un service tiers externe (formspree.io), en dehors de
       toute protection CSRF/rate limiting et sans lien avec le vrai backend
       Contact construit dans COSMECHIC-CONTENT-LEGAL-001 — remplacé par un renvoi
       vers la page /Home/Contact réelle plutôt qu'une page dupliquée. *@
    <section class="animate-section container text-center" style="padding: 50px 20px;">
        <div class="section-heading">
            <h2>Contactez-nous</h2>
        </div>
        <p class="cx-lede">
            Une question sur votre commande, un produit ou notre boutique ?
        </p>
        <a class="btn btn-primary btn-lg" asp-controller="Home" asp-action="Contact">
            Nous écrire
        </a>
    </section>

    <!-- 9. Réseaux Sociaux -->
    <section class="animate-section container text-center social-section">
        <div class="section-heading">
            <h2>Rejoignez-nous sur nos réseaux sociaux</h2>
            <p>Suivez-nous pour rester informé de nos dernières actualités et offres.</p>
        </div>
        <a href="https://www.facebook.com/Cosmechic" target="_blank" rel="noopener noreferrer" style="text-decoration: none; color: #0d6efd; font-size: 1.5em;">
            <i class="fab fa-facebook" style="margin-right: 10px;"></i>Facebook
        </a>
        <a href="https://www.instagram.com/Cosmechic" target="_blank" rel="noopener noreferrer" style="text-decoration: none; color: #B14646; font-size: 1.5em;">
            <i class="fab fa-instagram" style="margin-right: 10px;"></i>Instagram
        </a>
        <a href="https://www.whatsapp.com/Cosmechic" target="_blank" rel="noopener noreferrer" style="text-decoration: none; color: #07af15; font-size: 1.5em;">
            <i class="fab fa-whatsapp" style="margin-right: 10px;"></i>WhatsApp
        </a>
    </section>
</div>