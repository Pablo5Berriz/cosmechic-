@model Cosmechic.Models.ViewModels.ContactMessageInput

<section class="py-5" style="margin-top: 100px;">
    <div class="text-center">
        <h1 class="fw-bold" style="color:darkblue">Nous joindre</h1>
        <p class="lead mt-3">Une question sur une commande, un produit ou notre boutique ? Écrivez-nous.</p>
    </div>
</section>
<hr />

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            @if (TempData["ContactSuccess"] is true)
            {
                <div class="alert alert-success" role="status">
                    Votre message a été envoyé. Notre équipe vous répondra par courriel dès que possible.
                </div>
            }

            <form asp-action="Contact" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                <fieldset>
                    <legend class="visually-hidden">Votre message</legend>
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label">Nom</label>
                        <input asp-for="Name" class="form-control" autocomplete="name" required maxlength="200" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">Adresse électronique</label>
                        <input asp-for="Email" type="email" class="form-control" autocomplete="email" required maxlength="256" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Message" class="form-label">Votre message</label>
                        <textarea asp-for="Message" class="form-control" rows="6" required maxlength="4000"></textarea>
                        <span asp-validation-for="Message" class="text-danger"></span>
                    </div>
                </fieldset>
                <button type="submit" class="btn btn-lg" style="background-color: darkblue; color: white;">Envoyer</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
}
