@{
    var supportEmail = ViewBag.SupportEmail as string;
}

<section class="py-5" style="margin-top: 100px;">
    <div class="text-center">
        <h1 class="fw-bold" style="color:darkblue">Conditions d'utilisation et de vente</h1>
    </div>
</section>
<hr />

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="alert alert-warning" role="note">
                Ce document décrit le fonctionnement réel du site. Il n'a pas fait l'objet d'une révision
                juridique et ne constitue pas un contrat validé par un professionnel du droit.
            </div>

            <section class="mb-4">
                <h2 class="h5 fw-bold">Utilisation du site</h2>
                <p>
                    Le contenu de ce site est destiné à un usage personnel. Vous vous engagez à ne pas tenter de
                    contourner ses mécanismes de sécurité ni d'en perturber le fonctionnement.
                </p>
            </section>

            <section class="mb-4">
                <h2 class="h5 fw-bold">Comptes</h2>
                <p>
                    Créer un compte vous permet de suivre vos commandes, gérer vos adresses de livraison et vos
                    demandes de retour. Vous êtes responsable de la confidentialité de vos identifiants de
                    connexion.
                </p>
            </section>

            <section class="mb-4">
                <h2 class="h5 fw-bold">Commandes et paiements</h2>
                <p>
                    Le prix, les frais de livraison et les taxes applicables sont calculés et affichés avant que
                    vous ne soyez redirigé vers notre processeur de paiement (Stripe). Nous ne stockons jamais
                    votre numéro de carte bancaire.
                </p>
            </section>

            <section class="mb-4">
                <h2 class="h5 fw-bold">Disponibilité</h2>
                <p>
                    La disponibilité des produits est vérifiée au moment du paiement. Il est possible qu'un
                    produit devienne indisponible entre l'ajout au panier et la confirmation de la commande.
                </p>
            </section>

            <section class="mb-4">
                <h2 class="h5 fw-bold">Expédition</h2>
                <p>
                    Voir notre <a asp-controller="Home" asp-action="Shipping">politique de livraison</a> pour le
                    détail des méthodes disponibles et de leur coût.
                </p>
            </section>

            <section class="mb-4">
                <h2 class="h5 fw-bold">Retours et remboursements</h2>
                <p>
                    Voir notre <a asp-controller="Home" asp-action="Returns">politique de retours et
                    remboursements</a> pour le détail du processus.
                </p>
            </section>

            <section class="mb-4">
                <h2 class="h5 fw-bold">Propriété intellectuelle</h2>
                <p>
                    Les textes, images et logos présents sur ce site sont la propriété de Cosmechic ou de ses
                    fournisseurs et ne peuvent être réutilisés sans autorisation.
                </p>
            </section>

            <section class="mb-4">
                <h2 class="h5 fw-bold">Loi applicable</h2>
                <p>
                    La juridiction et le droit applicable à ces conditions n'ont pas encore été déterminés par
                    l'entreprise.
                </p>
            </section>

            <section>
                <h2 class="h5 fw-bold">Contact</h2>
                @if (!string.IsNullOrWhiteSpace(supportEmail))
                {
                    <p>
                        Pour toute question sur ces conditions, écrivez-nous à
                        <a href="mailto:@supportEmail">@supportEmail</a> ou via notre
                        <a asp-controller="Home" asp-action="Contact">page Contact</a>.
                    </p>
                }
                else
                {
                    <p>
                        Pour toute question sur ces conditions, utilisez notre
                        <a asp-controller="Home" asp-action="Contact">page Contact</a>.
                    </p>
                }
            </section>
        </div>
    </div>
</div>
