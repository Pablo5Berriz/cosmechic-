@using Cosmechic.Models.ViewModels
@model ReturnRequestFormVM

@{
    ViewData["Title"] = "Demander un retour";
}

<section class="py-5" style="margin-top: 100px;">
    <div class="text-center">
        <h1 class="fw-folder" style="color:darkblue">@ViewData["Title"]</h1>
    </div>
</section>

@if (TempData["error"] != null)
{
    <div class="container"><div class="alert alert-danger">@TempData["error"]</div></div>
}

<div class="container">
    @if (!Model.Lines.Any(l => l.MaxReturnable > 0))
    {
        <div class="alert alert-info">Aucun article de cette commande n'est actuellement admissible à un retour.</div>
    }
    else
    {
        <form asp-action="Request" method="post">
            <input type="hidden" name="OrderId" value="@Model.OrderId" />
            <div class="form-group mb-3">
                <label>Motif général du retour</label>
                <input type="text" name="Reason" class="form-control" />
            </div>
            <div class="form-group mb-3">
                <label>Commentaire</label>
                <textarea name="CustomerComment" class="form-control"></textarea>
            </div>

            <table class="table">
                <thead>
                    <tr><th>Produit</th><th>Acheté</th><th>Retournable</th><th>Quantité à retourner</th></tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < Model.Lines.Count; i++)
                    {
                        var line = Model.Lines[i];
                        <tr>
                            <td>
                                @line.ProduitNom
                                <input type="hidden" name="Items[@i].OrderDetailId" value="@line.OrderDetailId" />
                            </td>
                            <td>@line.Purchased</td>
                            <td>@line.MaxReturnable</td>
                            <td>
                                <input type="number" name="Items[@i].Quantity" min="0" max="@line.MaxReturnable" value="0" class="form-control" style="max-width: 100px;" @(line.MaxReturnable == 0 ? "disabled" : "") />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <button type="submit" class="btn btn-primary">Soumettre la demande de retour</button>
        </form>
    }
</div>
