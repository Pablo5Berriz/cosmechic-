<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @if (ViewData["MetaDescription"] is string metaDescription && !string.IsNullOrWhiteSpace(metaDescription))
    {
        <meta name="description" content="@metaDescription" />
    }
    <title>@ViewData["Title"] Cosmechic</title>

    <!-- FontAwesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css?family=Merriweather+Sans:400,700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css?family=Merriweather:400,300,400italic,700&display=swap" rel="stylesheet">

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css?family=Merriweather+Sans:400,700" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true" />
    <!-- COSMECHIC-UX-001 : design system additif, chargé après styles.css pour
         affiner (jamais remplacer) les composants Bootstrap déjà en usage. -->
    <link rel="stylesheet" href="~/css/design-system.css" asp-append-version="true" />

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="~/assets/favicon.ico" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

    <!-- Tinymce -->
    <script src="https://cdn.tiny.cloud/1/sexd07j0a6zabf5ek64592lj8r47d0cbg9lp9dsjq2b17vmk/tinymce/7/tinymce.min.js" referrerpolicy="origin"></script>
    <style>
        header {
            background-color: darkorange;
            box-shadow: 0px 4px 15px rgba(0, 0, 0, 0.1);
            padding: 15px 20px;
            position: fixed;
            width: 100%;
            top: 0;
            z-index: 1000;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .navbar-nav a {
            font-size: 1.2rem;
            font-weight: bold;
            color: #333;
            transition: color 0.3s ease-in-out;
        }

        .navbar-nav a:hover {
            color: white;
        }

        /* COSMECHIC-UX-001 (section 7) : le header d'origine déclarait
           navbar-expand-lg / id="navbarSupportedContent" sans jamais poser le
           bouton bascule (.navbar-toggler) ni la classe .collapse sur le
           conteneur — en dessous de 992px, le menu (Accueil/À propos/
           Catégories/Nous joindre), la recherche et le compte/panier
           restaient tous visibles en permanence dans un header fixe étroit :
           navigation mobile inutilisable et risque de débordement horizontal.
           Le panneau ci-dessous ajoute le comportement Bootstrap standard
           (bouton + .collapse), positionné en dropdown sous le header fixe. */
        @@media (max-width: 991.98px) {
            header {
                flex-wrap: wrap;
            }

            .navbar-collapse {
                position: absolute;
                top: 100%;
                left: 0;
                right: 0;
                background-color: darkorange;
                padding: 15px 20px;
                max-height: calc(100vh - 90px);
                overflow-y: auto;
                box-shadow: 0 8px 12px rgba(0, 0, 0, 0.15);
            }

            .navbar-collapse .navbar-nav {
                margin-bottom: 15px;
            }
        }

        .footer {
            background-color: #222;
            color: #ccc;
            padding: 40px 0;
        }

        .footer h5 {
            color: #fff;
            margin: 20px;
        }

        .footer-links ul {
            list-style: none;
            padding: 0;
        }

        .footer-links ul li {
            margin: 10px;
        }

        .footer-links a {
            color: #ccc;
            text-decoration: none;
        }

        .footer-links a:hover {
            color: #fff;
            text-decoration: underline;
        }
    </style>
</head>

<body>
    <a href="#main-content" class="cx-skip-link">Aller au contenu principal</a>
    <header>
        <!-- Logo -->
        <a class="text-white" asp-controller="Home" asp-action="Index">
            <img src="~/assets/img/Logo.png" alt="Cosmechic Logo" style="height: 90px;">
        </a>

        <!-- Bouton bascule menu mobile (voir style navbar-collapse ci-dessus) -->
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent"
                aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Ouvrir le menu de navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <!-- Menu de navigation + recherche + compte/panier : un seul panneau repliable
             en dessous de 992px, regroupant tout ce qui était auparavant toujours visible. -->
        <div class="collapse navbar-collapse flex-grow-1" id="navbarSupportedContent">
            <nav class="navbar navbar-expand-lg p-0" aria-label="Navigation principale">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link active text-dark" asp-controller="Home" asp-action="Index">Accueil</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-controller="Home" asp-action="About">À propos</a>
                    </li>
                    <!-- Menu déroulant Catégories -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle text-dark" href="#" id="categoriesDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Catégories
                        </a>
                        <ul class="dropdown-menu" aria-labelledby="categoriesDropdown">
                            @if (ViewBag.Categories != null && ViewBag.Categories.Count > 0)
                            {
                                foreach (var categorie in ViewBag.Categories)
                                {
                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Produits"
                                           asp-action="ParCategorie"
                                           asp-route-id="@categorie.CategorieId">
                                            @categorie.Nom
                                        </a>
                                    </li>
                                }
                            }
                            else
                            {
                                <li><span class="dropdown-item text-muted">Aucune catégorie disponible</span></li>
                            }
                        </ul>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-controller="Home" asp-action="Contact">Nous joindre</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-controller="Home" asp-action="Faq">FAQ</a>
                    </li>
                </ul>
            </nav>

            <!-- 🔥 Section Connexion et Panier -->
            <div class="d-flex flex-column flex-lg-row align-items-lg-center gap-lg-4 mt-3 mt-lg-0">
                <form method="get" asp-controller="Produits" asp-action="Rechercher" class="d-flex mb-2 mb-lg-0" role="search">
                    <label for="cx-search-input" class="visually-hidden">Rechercher un produit</label>
                    <input id="cx-search-input" type="text" name="Q" class="form-control form-control-sm" placeholder="Rechercher un produit..." />
                    <button type="submit" class="btn btn-outline-primary btn-sm ms-1">
                        <i class="bi bi-search" aria-hidden="true"></i>
                        <span class="visually-hidden">Rechercher</span>
                    </button>
                </form>
                <div class="mb-2 mb-lg-0">
                    <partial name="_LoginPartial" />
                </div>
                <a class="nav-link text-dark fw-bold" asp-controller="Cart" asp-action="Index">
                    @await Component.InvokeAsync("ShoppingCart")
                </a>
            </div>
        </div>
    </header>

    <!-- Le contenu principal se décale pour ne pas être masqué par l'en-tête fixe -->
    <main id="main-content" role="main" class="pb-3" style="margin-top: 120px;">
        @RenderBody()
    </main>

    @* COSMECHIC-CONTENT-LEGAL-001 (section 18) : liens vers des routes réelles
       uniquement — la version précédente pointait vers des chemins statiques
       (/notrehistoire, /blog, /localisez-nous, "Catégorie 1/2/3"...) qui ne
       correspondaient à aucune route existante. *@
    <footer class="container-fluid bg-dark text-white py-4">
        <div class="container footer-links">
            <div class="row">
                <div class="col-md-3">
                    <h5>Cosmechic</h5>
                    <ul>
                        <li><a asp-controller="Home" asp-action="About">À propos</a></li>
                        <li><a asp-controller="Home" asp-action="Contact">Contact</a></li>
                        <li><a asp-controller="Categories" asp-action="Customer">Catégories</a></li>
                    </ul>
                </div>
                <div class="col-md-3">
                    <h5>Service client</h5>
                    <ul>
                        <li><a asp-controller="Home" asp-action="Faq">FAQ</a></li>
                        <li><a asp-controller="Home" asp-action="Shipping">Livraison</a></li>
                        <li><a asp-controller="Home" asp-action="Returns">Retours et remboursements</a></li>
                    </ul>
                </div>
                <div class="col-md-3">
                    <h5>Légal</h5>
                    <ul>
                        <li><a asp-controller="Home" asp-action="Privacy">Confidentialité</a></li>
                        <li><a asp-controller="Home" asp-action="Terms">Conditions d'utilisation</a></li>
                    </ul>
                </div>
                <div class="col-md-3">
                    <h5>Mon compte</h5>
                    <ul>
                        <li><a asp-controller="Account" asp-action="Index">Espace client</a></li>
                        <li><a asp-controller="Account" asp-action="Orders">Mes commandes</a></li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="container text-center">
            <img class="img-fluid" src="~/assets/img/payments.png" alt="Moyens de paiement" style="margin-bottom: 30px;">
            <p>&copy; 2024 Cosmechic. Tous droits réservés.</p>
        </div>
    </footer>

    <!-- Scripts -->
    @* COSMECHIC-RELEASE-CONFIG-001 (section 6) : jQuery et le bundle JS Bootstrap
       étaient chargés depuis un CDN alors que des copies locales identiques/cohérentes
       existaient déjà dans wwwroot/lib (jQuery 3.6.0 = version CDN exacte ; Bootstrap
       JS 5.1.0 = même version que le CSS Bootstrap déjà local ci-dessus, ligne 19).
       La navigation mobile (.navbar-toggler / data-bs-toggle) et les menus déroulants
       dépendent entièrement de ce bundle : un CDN tiers indisponible rendait ces
       éléments non fonctionnels sans qu'aucune erreur ne soit visible côté serveur.
       Aucune nouvelle dépendance téléchargée — uniquement les fichiers déjà présents. *@
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/scripts.js"></script>
    <script src="https://cdn.startbootstrap.com/sb-forms-latest.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>