@model Cosmechic.Models.TaxRate

@{
    ViewData["Title"] = "Ajouter un taux de taxe";
    if (User.IsInRole("Admin"))
    {
        Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    }
}

<h1 style="margin-top: 100px;">@ViewData["Title"]</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group mb-3">
                <label asp-for="Jurisdiction" class="control-label"></label>
                <input asp-for="Jurisdiction" class="form-control" placeholder="ex. TVQ (Québec)" />
                <span asp-validation-for="Jurisdiction" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="CountryCode" class="control-label"></label>
                <input asp-for="CountryCode" class="form-control" placeholder="CA" maxlength="2" />
                <span asp-validation-for="CountryCode" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="RegionCode" class="control-label"></label>
                <input asp-for="RegionCode" class="form-control" placeholder="QC (laisser vide pour un taux fédéral applicable à toutes les provinces)" />
                <span asp-validation-for="RegionCode" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Rate" class="control-label"></label>
                <input asp-for="Rate" class="form-control" placeholder="ex. 0.09975 pour 9.975 %" />
                <span asp-validation-for="Rate" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="EffectiveFrom" class="control-label"></label>
                <input asp-for="EffectiveFrom" class="form-control" />
                <span asp-validation-for="EffectiveFrom" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="EffectiveTo" class="control-label"></label>
                <input asp-for="EffectiveTo" class="form-control" />
                <small class="form-text text-muted">Laisser vide : toujours en vigueur.</small>
                <span asp-validation-for="EffectiveTo" class="text-danger"></span>
            </div>
            <div class="form-group mt-3">
                <a asp-action="Index" class="btn btn-secondary">Retour à la liste</a>
                <button type="submit" class="btn btn-primary">Créer</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
