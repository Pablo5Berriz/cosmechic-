@model ShoppingCart

@{
    ViewData["Title"] = "Ajout produit";
    var enStock = Model.Produit.Disponible && Model.Produit.Stock > 0;
}

<section class="py-5" style="margin-top: 100px;">
    <div class="text-center">
        <h1 class="fw-folder" style=" color:darkblue">
            @ViewData["Title"]
        </h1>
    </div>
</section>

<section class="py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card shadow">
                    <div class="card-body">
                        <div class="row justify-content-center">
                            <div class="col-md-6">
                                <img src="@Url.Content("~/Images_Produits/" + Model.Produit.Image)" class="img-fluid rounded" alt="Image de @Model.Produit.Image">
                            </div>
                            <div class="col-md-6">
                                <h2 class="fw-bold">@Model.Produit.Nom</h2>
                                <p>@Model.Produit.Description</p>
                                @if (enStock)
                                {
                                    <p class="text-muted">@Model.Produit.Stock en stock</p>
                                    <form method="post" class="mt-4" id="addToCartForm">
                                        <input hidden asp-for="ProduitId" />
                                        <div class="input-group mb-3">
                                            <span class="input-group-text">Quantité</span>
                                            <input asp-for="Count" type="number" value="1" min="1" max="@Model.Produit.Stock" class="form-control" aria-label="Quantité" aria-describedby="basic-addon2">
                                        </div>
                                        <button type="submit" class="btn btn-primary btn-block">Ajouter au panier</button>
                                    </form>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Rupture de stock</span>
                                }
                            </div>
                        </div>
                        <div class="text-center mt-4">
                            <a asp-controller="Categories" asp-action="Customer" class="btn btn-outline-primary">Continuer les achats</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script nonce="@CspNonce.Nonce">
    document.getElementById("addToCartForm")?.addEventListener("submit", function () {
        window.history.back();
    });
</script>

