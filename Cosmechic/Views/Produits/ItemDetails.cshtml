@model ShoppingCart

@{
    // COSMECHIC-UX-001 : le titre était fixe ("Ajout produit") pour tous les
    // produits — chaque page de détail avait donc le même <title>, contraire à
    // la section 21 (titres descriptifs par page). Utilise désormais le nom réel
    // du produit.
    ViewData["Title"] = Model.Produit.Nom;
    ViewData["MetaDescription"] = !string.IsNullOrWhiteSpace(Model.Produit.Description)
        ? Model.Produit.Description.Substring(0, Math.Min(155, Model.Produit.Description.Length))
        : null;
    var enStock = Model.Produit.Disponible && Model.Produit.Stock > 0;
}

<section class="py-5" style="margin-top: 100px;">
    <div class="text-center">
        <h1 class="fw-bold" style=" color:darkblue">
            @Model.Produit.Nom
        </h1>
    </div>
</section>

<section class="py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card shadow">
                    <div class="card-body">
                        <div class="row justify-content-center">
                            <div class="col-md-6">
                                @if (!string.IsNullOrWhiteSpace(Model.Produit.Image))
                                {
                                    <img src="@Url.Content("~/Images_Produits/" + Model.Produit.Image)" class="img-fluid rounded" alt="@Model.Produit.Nom" loading="lazy">
                                }
                                else
                                {
                                    <div class="cx-empty-state">
                                        <i class="bi bi-image" aria-hidden="true"></i>
                                        <p class="mb-0">Aucune image disponible</p>
                                    </div>
                                }
                            </div>
                            <div class="col-md-6">
                                <p>@Model.Produit.Description</p>
                                @if (enStock)
                                {
                                    <p class="text-muted">@Model.Produit.Stock en stock</p>
                                    <form method="post" class="mt-4" id="addToCartForm">
                                        <input hidden asp-for="ProduitId" />
                                        <div class="input-group mb-3">
                                            <label class="input-group-text" for="Count">Quantité</label>
                                            <input asp-for="Count" type="number" value="1" min="1" max="@Model.Produit.Stock" class="form-control">
                                        </div>
                                        <button type="submit" class="btn btn-primary btn-block">Ajouter au panier</button>
                                    </form>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Rupture de stock</span>
                                }
                            </div>
                        </div>
                        <div class="text-center mt-4">
                            <a asp-controller="Categories" asp-action="Customer" class="btn btn-outline-primary">Continuer les achats</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

